# Nazwy sekretów. Wartości wpisz w .env (ignorowany przez git). NIE commituj .env.

# Anthropic (konto kancelarii)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Gmail – skrzynka Moniki (IMAP/SMTP)
AGENT_EMAIL=
IMAP_HOST=imap.gmail.com
SMTP_HOST=smtp.gmail.com
# Nazwa nadawcy w mailach (domyślnie: Monika – asystentka kancelarii)
# AGENT_NAME=

# Logowanie – zalecane OAuth (XOAUTH2). REFRESH_TOKEN wpisuje `python -m kancelaria_agent oauth-setup`.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Alternatywa: hasło aplikacji (używane tylko, gdy brak danych OAuth)
AGENT_EMAIL_APP_PASSWORD=
